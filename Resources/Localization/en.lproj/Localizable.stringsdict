	<!-- MARK: Sources/PortsApp/QuitCoordinator.swift -->
	<key>%lld processes didn't respond to Force Quit either. Check them in Activity Monitor. If you quit anyway, they keep running without the app.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@processes@</string>
		<key>processes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>The process didn't respond to Force Quit either. Check it in Activity Monitor. If you quit anyway, it keeps running without the app.</string>
			<key>other</key>
			<string>The processes didn't respond to Force Quit either. Check them in Activity Monitor. If you quit anyway, they keep running without the app.</string>
		</dict>
	</dict>
	<key>%lld services are still running 15 seconds after the stop request: %@. Force Quit ends the processes the app started, without cleanup; unsaved data may be lost.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$@ %1$#@running@ Force Quit ends the processes the app started, without cleanup; unsaved data may be lost.</string>
		<key>running</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>is still running 15 seconds after the stop request.</string>
			<key>other</key>
			<string>are still running 15 seconds after the stop request.</string>
		</dict>
	</dict>
	<key>%lld services couldn't be stopped: %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$@ %1$#@stopped@</string>
		<key>stopped</key>
		<dict>
